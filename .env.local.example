# ── SecComply Environment Variables ──────────────────────────────────────────
# Security fix C-01: This file must NEVER be committed to Git.
# Security fix C-02: Secrets must NEVER use the NEXT_PUBLIC_ prefix.
#
# How to use:
#   1. Copy this file to .env.local
#   2. Fill in your actual values
#   3. Add to Netlify: Site Settings → Environment Variables
#
# NEVER prefix secrets with NEXT_PUBLIC_ — that exposes them in browser bundles!

# ── Resend ────────────────────────────────────────────────────────────────────
# Rotate this key immediately if it was ever committed to git.
# Get a new key from: https://resend.com/api-keys
RESEND_API_KEY=re_REPLACE_WITH_YOUR_KEY

# ── Email Notification Target ─────────────────────────────────────────────────
NOTIFICATION_EMAIL=info@seccomply.net

# ── Site URL (safe to be public — used for canonical URLs, NOT a secret) ──────
NEXT_PUBLIC_SITE_URL=https://seccomply.net

# ── Add any future secrets here without NEXT_PUBLIC_ prefix ──────────────────
